import { Button, VerticalBox, GroupBox, HorizontalBox, GridBox, StandardListView, ComboBox, LineEdit, Palette, StandardButton } from "std-widgets.slint";

export component PerturbationProperties inherits Rectangle {
    in-out property <int> perturbation_type: 0;
    in-out property <[float]> parameters: [1.0, 1.0, 1.0];
    out property <bool> accepted;
    background: Palette.alternate-background;
    VerticalBox {
    Text {
        text: "Параметры распределения";
        font-size: 16px;
    }
    cb:=ComboBox {
        model: ["Изотропное", "Ортотропное"];
        current-index: perturbation_type;
        changed current-index => {
            perturbation_type = self.current-index;
        }
    }
    if cb.current-index==0:
    VerticalBox {
        Text {
            text: "Lc";
        }
        LineEdit {
            input-type: InputType.decimal;
            text: parameters[0];
            edited(text) => {
                parameters = [text.to-float(), parameters[1], parameters[2]];
            }
        }
    }

    if cb.current-index==1:
    VerticalBox {
            GridBox {
            Row {
                Text {
                    text: "Lx";
                }
                Text {
                    text: "Ly";
                }
                Text {
                    text: "Lz";
                }
            } // Row
            Row {
                LineEdit {
                    input-type: InputType.decimal;
                    text: parameters[0];
                    edited(text) => {
                        parameters = [text.to-float(), parameters[1], parameters[2]];
                    }
                }
                LineEdit {
                    input-type: InputType.decimal;
                    text: parameters[1];
                    edited(text) => {
                        parameters = [parameters[0], text.to-float(), parameters[2]];
                    }
                }
                LineEdit {
                    input-type: InputType.decimal;
                    text: parameters[2];
                    edited(text) => {
                        parameters = [parameters[0], parameters[1], text.to-float()];
                    }
                }
            } // Row
        }
    }
}
}

export component AppWindow inherits Window {
    in-out property <string> file_path: "выберите k или inp файл";
    in property <string> model_info: "";
    in-out property <[StandardListViewItem]> perturbations;
    in-out property <[StandardListViewItem]> random_fields;
    in-out property <int> current_perturbation_index: -1;
    preferred-width: 800px;
    preferred-height: 800px;
    callback choose_file();
    callback add_perturbation(int, [float]);
    callback change_current_perturbation(int);
    callback delete_current_perturbation(int);

    VerticalBox {
        // alignment: start;
        pp:= PopupWindow {
            close-policy: close-on-click-outside;
            x: 20px;
            y: 20px;
            Rectangle {
                background: Palette.alternate-background;
                VerticalLayout {
                pert_props:=PerturbationProperties {}
                HorizontalBox {
                    StandardButton {
                        kind: ok;
                        clicked => {
                            add_perturbation(pert_props.perturbation_type, pert_props.parameters);
                            pp.close();
                        }
                    }
                    StandardButton {
                        kind: cancel;
                        clicked => {
                            pp.close();
                        }
                    }
                }
                }
            }
        }
        // open file group
        Rectangle {
            border-width: 3px;
            border-color: Palette.alternate-background;
        VerticalBox {
            GroupBox {
                title: "Открыть файл с сеточной моделью";
                height: 100px;
                vertical-stretch: 0.0;
                HorizontalBox {
                    Text{
                        text: file_path;
                        vertical-alignment: center;
                    }
                    Button {
                        width: 60px;
                        text: "Open";
                        clicked => {
                            choose_file();
                        }
                    }
                }
            } // open file group
        }
        }
        Text {
            vertical-stretch: 0.0;
            text: model_info;
        }
        GridBox {
            horizontal-stretch: 1.0;
            vertical-stretch: 1.0;
            Row {
                Text {text: "Распределения";}
                Text {text: "Поля";}
            }
            Row {
                HorizontalBox {
                    alignment: start;
                    Button {
                        text: "+";
                        width: 30px;
                        clicked => {
                            pp.show();
                        };
                    }
                    Button {
                        text:"-";
                        width: 30px;
                        clicked => {
                            delete_current_perturbation(current_perturbation_index);
                        }
                    }
                }
                HorizontalBox {
                    alignment: start;
                    Button {
                        text: "+";
                        width: 30px;
                    }
                    Button {
                        text:"-";
                        width: 30px;
                    }
                }
            }
            Row {
                Rectangle {
                    border-width: 2px;
                    border-color: Palette.alternate-background;
                    StandardListView {
                        model: perturbations;
                        current-item: current_perturbation_index;
                        changed current-item => {
                            current_perturbation_index = self.current-item;
                            change_current_perturbation(self.current-item);
                        }
                    }
                }
                Rectangle {
                    border-width: 2px;
                    border-color: Palette.alternate-background;
                    StandardListView {
                    model: random_fields;
                    }
                }
            }
        }
    }
}
