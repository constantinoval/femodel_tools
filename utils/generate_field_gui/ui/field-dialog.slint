import { Button, ComboBox, LineEdit, Palette, StandardButton, VerticalBox, HorizontalBox, GridBox, Switch } from "std-widgets.slint";

export component FieldPropertiesDialog inherits Rectangle {
    background: Palette.background;
    border-width: 2px;
    border-color: Palette.alternate-foreground;
    in-out property <string> name <=> field_name.text;
    in-out property <string> mean <=> field_mean.text;
    in-out property <string> std <=> field_std.text;
    in-out property <string> id <=> field_id.text;
    in-out property <bool> inverse <=> field_inverse.checked;
    in-out property <bool> is_trunc <=> is_truncated.checked;
    in-out property <string> trunc_min <=> field_truncated_min.text;
    in-out property <string> trunc_max <=> field_truncated_max.text;

    property <bool> valid2: true;
    property <bool> valid1: mean.to-float()>=0 && std.to-float() > 0 && id.to-float()>0;
    property <bool> valid: valid1 && valid2;

    callback accepted(int, string, float, float, bool, [float]);

    width: 600px;
    height: 420px;

    VerticalBox {
        padding: 12px;
        // spacing: 8px;
        Text { text: "Параметры случайного поля"; font-size: 16px; horizontal-alignment: center; height: 30px;}
        GridBox {
            Row {
                Text {
                    text: "Идентификатор поля";
                    vertical-alignment: center;
                }
                field_id:=LineEdit{
                    text: "1";
                    input-type: number;
                }
            } // Row 0
            Row {
                Text {
                    vertical-alignment: center;
                    text: "Имя поля";
                }
                field_name:=LineEdit {
                    placeholder-text: "название поля для записи в файл";
                }
            } // Row 1
            Row {
                Text {
                    vertical-alignment: center;
                    text: "Среднее значение поля";
                }
                field_mean:=LineEdit {
                    input-type: decimal;
                    text: 0.0;
                }
            } // Row 2
            Row {
                Text {
                    vertical-alignment: center;
                    text: "Стандартное отклонение поля";
                }
                field_std:=LineEdit {
                    input-type: decimal;
                    text: "1.0";
                }
            } // Row 3
        } // GridBox
            field_inverse:=Switch {
                text: "Инвертировать поле";
            }

            is_truncated:=Switch {
                text: "Урезанное поле";
                changed checked => {
                    if !is_trunc {root.valid2 = true;}
                    if is_trunc {root.valid2 = trunc_min.to-float()<mean.to-float() && trunc_max.to-float()>mean.to-float();}
                    root.valid = valid1 && valid2;
                }
            }
                HorizontalBox {
                visible: is_trunc;
                    Text {
                        vertical-alignment: center;
                        text: "min";
                    }
                    field_truncated_min:= LineEdit {
                        input-type: decimal;
                        text: "-3.0";
                    }
                    Text {
                        vertical-alignment: center;
                        text: "max";
                    }
                    field_truncated_max:= LineEdit {
                        input-type: decimal;
                        text: "3.0";
                    }
                }
        // сообщение о неверном вводе
        Text {
            text: root.valid?"":"Среднее значение должно быть >=0, стандартное отклонение >0, идентификатор >0, минимальное значение<среднего, максимальное значение>среднего";
            color: red;
            wrap: word-wrap;
        }
        HorizontalBox {
            alignment: end;
            StandardButton {
                enabled: root.valid;
                kind: ok;
                clicked => {
                    root.accepted(id.to-float(), name, mean.to-float(), std.to-float(), inverse, !is_trunc?[]:[trunc_min.to-float(), trunc_max.to-float()]);
                    root.id = root.id.to-float() + 1;
                    root.visible = false;
                }
            }
            StandardButton {
                kind: cancel;
                clicked => {
                    root.visible = false;
                }
            }
        }
    } //main vertical box
}
