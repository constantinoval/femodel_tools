import { Button, VerticalBox, GroupBox, HorizontalBox, GridBox, StandardListView, ComboBox, LineEdit, Palette, StandardButton } from "std-widgets.slint";
import { PerturbationDialog } from "perturbation-dialog.slint";
import { FieldPropertiesDialog } from "field-dialog.slint";

export component AppWindow inherits Window {
    in-out property <string> file_path: "выберите k или inp файл";
    in property <string> model_info: "";
    in-out property <[StandardListViewItem]> perturbations;
    in-out property <[StandardListViewItem]> random_fields;
    in-out property <int> current_perturbation_index <=> perturbation_list.current-item;
    in-out property <int> current_field_index <=> field_list.current-item;
    min-width: 800px;
    min-height: 800px;
    callback choose_file();
    callback add_perturbation(int, [float]);
    callback change_current_perturbation(int);
    callback delete_current_perturbation(int);
    callback delete_current_field(int, int);
    callback add_field(int, int, string, float, float, bool); // add field to perturbation index with id, name, mean, std and inverted
    callback generate();

    property <bool> main_context_visible: !(add_perturbation_dialog.visible || add_field_dialog.visible);

    add_perturbation_dialog:= PerturbationDialog {
        visible: false;
        accepted (perturbation_type, props) => {
            root.add_perturbation(perturbation-type, props);
        }
    }

    add_field_dialog:= FieldPropertiesDialog {
        visible: false;
        accepted (id, name, mean, std, inverse) => {
            root.add_field(current_perturbation_index, id, name, mean, std, inverse);
        }
    }

    VerticalBox {
        visible: main_context_visible;
        // alignment: start;
        // open file group
        Rectangle {
            border-width: 3px;
            border-color: Palette.alternate-background;
        VerticalBox {
            GroupBox {
                title: "Открыть файл с сеточной моделью";
                height: 100px;
                vertical-stretch: 0.0;
                HorizontalBox {
                    Text{
                        text: file_path;
                        vertical-alignment: center;
                    }
                    Button {
                        width: 60px;
                        text: "Open";
                        clicked => {
                            choose_file();
                        }
                    }
                }
            } // open file group
        Text {
            vertical-stretch: 0.0;
            text: model_info;
        }
        }
        }
        GridBox {
            horizontal-stretch: 1.0;
            vertical-stretch: 1.0;
            Row {
                Text {text: "Распределения";}
                Text {text: "Поля";}
            }
            Row {
                HorizontalBox {
                    alignment: start;
                    Button {
                        text: "+";
                        width: 30px;
                        clicked => {
                            add_perturbation_dialog.visible = true;
                        };
                    }
                    Button {
                        text:"-";
                        width: 30px;
                        enabled: current_perturbation_index>=0;
                        clicked => {
                            delete_current_perturbation(current_perturbation_index);
                            change_current_perturbation(current_perturbation_index);
                        }
                    }
                }
                HorizontalBox {
                    alignment: start;
                    Button {
                        text: "+";
                        enabled: current_perturbation_index>=0;
                        width: 30px;
                        clicked => {
                            add_field_dialog.visible = true;
                        }
                    }
                    Button {
                        text:"-";
                        enabled: current_field_index>=0;
                        width: 30px;
                        clicked => {
                            root.delete_current_field(root.current_perturbation_index, root.current_field_index);
                        }
                    }
                }
            }
            Row {
                Rectangle {
                    border-width: 2px;
                    border-color: Palette.alternate-background;
                    perturbation_list:=StandardListView {
                        model: perturbations;
                        changed current-item => {
                            current_perturbation_index = self.current-item;
                            change_current_perturbation(self.current-item);
                        }
                    }
                }
                Rectangle {
                    border-width: 2px;
                    border-color: Palette.alternate-background;
                    field_list:=StandardListView {
                    model: random_fields;
                    }
                }
            }
        }
        Button {
            text: "Генерировать поля";
            clicked => {
                root.generate();
            }
        }
    } // main vertical box

}
