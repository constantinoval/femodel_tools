import { Button, VerticalBox, GroupBox, HorizontalBox, GridBox, StandardListView } from "std-widgets.slint";

export component AppWindow inherits Window {
    in-out property <string> file_path: "выберите k или inp файл";
    in property <string> model_info: "";
    in-out property <[StandardListViewItem]> perturbations;
    in-out property <[StandardListViewItem]> random_fields;
    in-out property <int> current_perturbation_index: -1;
    preferred-width: 600px;
    preferred-height: 500px;
    callback choose_file();
    callback add_perturbation(int, [float]);
    callback change_current_perturbation(int);

    VerticalBox {
        // open file group
        GroupBox {
            title: "Открыть файл с сеточной моделью";
            height: 100px;
            vertical-stretch: 0.0;
            HorizontalBox {
                Text{
                    text: file_path;
                    vertical-alignment: center;
                }
                Button {
                    width: 60px;
                    text: "Open";
                    clicked => {
                        choose_file();
                    }
                }
            }
        } // open file group
        Text {
            vertical-stretch: 0.0;
            text: model_info;
        }
        GridBox {
            horizontal-stretch: 1.0;
            vertical-stretch: 1.0;
            Row {
                Text {text: "Распределения";}
                Text {text: "Поля";}
            }
            Row {HorizontalBox {
                    Button {
                        text: "+";
                        width: 30px;
                        clicked => {
                            add_perturbation(0, [1.0, 2.0, 3.0]);
                        };
                    }
                    Button {
                        text:"-";
                        width: 30px;
                    }
                    Text {}
                    }
                HorizontalBox {
                        Button {
                            text: "+";
                            width: 30px;
                        }
                        Button {
                            text:"-";
                            width: 30px;
                        }
                        Text {}
                        }
            }
            Row {
                StandardListView {
                    model: perturbations;
                    current-item: current_perturbation_index;
                    changed current-item => {
                        change_current_perturbation(self.current-item);
                    }
                }
                flds:=StandardListView {
                    model: random_fields;
                }
            }
        }
    }
}
